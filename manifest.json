{
  "manifest_version": 3,
  "name": "CookieSmith - Cookie Editor & Inspector",
  "short_name": "CookieSmith",
  "version": "1.1.1",
  "description": "Inspect, edit, create, and delete cookies for the current tab. 100% local, open-source cookie editor with zero telemetry.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "CookieSmith"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "cookies",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
